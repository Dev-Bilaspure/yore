#!/usr/bin/env bash
#
# Fast pre-commit checks — keep these snappy so committing stays painless.
# The slow/thorough checks live in pre-push and CI. Bypass with:
#   git commit --no-verify
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

# 1) gofmt — only the Go files being committed.
staged_go=$(git diff --cached --name-only --diff-filter=ACM -- '*.go')
if [ -n "$staged_go" ]; then
  unformatted=$(printf '%s\n' "$staged_go" | xargs gofmt -l 2>/dev/null || true)
  if [ -n "$unformatted" ]; then
    echo "✗ pre-commit: these files need gofmt (run: gofmt -w .)" >&2
    printf '%s\n' "$unformatted" | sed 's/^/    /' >&2
    exit 1
  fi
fi

# 2) go vet — also compiles, so it catches build breaks fast.
if ! go vet ./... 2>&1; then
  echo "✗ pre-commit: go vet failed" >&2
  exit 1
fi

echo "✓ pre-commit: gofmt + vet ok"
